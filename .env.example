# Copy to .env and fill in values before public hosting

# --- Required (production) ---
DATABASE_URL="file:./prisma/dev.db"
# Prefer Postgres in production, e.g. postgresql://user:pass@host:5432/janark
MONGODB_URI="mongodb://127.0.0.1:27017/janark"
# Local: http://localhost:3000
# Production / AdSense: MUST be https://janark.org (rebuild so NEXT_PUBLIC_* bake in)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Local Docker HTTP demo only — never on the public internet
# ALLOW_HTTP_SITE_URL=1
# Optional: override GitHub link on the marketing landing page
# NEXT_PUBLIC_GITHUB_URL="https://github.com/JANARK-The-People-s-Light/JANARK"

# Strong unique secrets (≥24 random chars). NEVER use the defaults in production.
PHONE_HASH_SALT="replace-with-long-random-secret"
HUMAN_TOKEN_SECRET="replace-with-long-random-secret"
IP_HASH_SALT="replace-with-long-random-secret"

# --- OTP SMS (required in production unless ALLOW_OTP_WITHOUT_SMS=1) ---
# Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Or MSG91:
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Local debugging only — NEVER set in production
EXPOSE_DEV_OTP=1
# ALLOW_OTP_WITHOUT_SMS=1

# --- Optional: object storage (ADR-0001) ---
# Default: local disk under public/uploads (or UPLOAD_DIR).
# STORAGE_PROVIDER=local
# UPLOAD_DIR=
# SeaweedFS Filer (enable in a follow-up compose PR):
# STORAGE_PROVIDER=seaweedfs
# SEAWEEDFS_FILER_URL=http://127.0.0.1:8888
# SEAWEEDFS_PATH_PREFIX=janark

# --- Optional: Cloudflare Turnstile (recommended for public OTP) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: ads / AdSense (OFF by default) ---
# NEXT_PUBLIC_ADS_ENABLED=true
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_FEED_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_FEED_MIDDLE=
# NEXT_PUBLIC_ADSENSE_SLOT_POST_BOTTOM=
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_BELOW_TRENDING=
# NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_BOTTOM=
# Optional /ads.txt override (use pub-… without ca-; newline-separated if multiple)
# ADS_TXT_LINES=google.com, pub-xxxxxxxxxxxxxxxx, DIRECT, f08c47fec0942fa0

# --- Optional: server-side outbound publish (OFF by default) ---
# ALLOW_CITIZEN_SOCIAL_PUBLISH=1
# Post channel
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# Feed / stories channel
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
# Chat channel
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_NOTIFY_TO=
