# Copy to .env and fill in values

DATABASE_URL="file:./prisma/dev.db"
MONGODB_URI="mongodb://127.0.0.1:27017/janark"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Phone OTP identity (hash salt — change in production)
PHONE_HASH_SALT="janark-dev-salt-change-me"
# Return OTP in API responses outside production (local debugging)
EXPOSE_DEV_OTP=1

# Optional — X / Twitter API (server-side posting)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Optional — Meta app (Facebook Page, Instagram, WhatsApp Cloud)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_NOTIFY_TO=
