# Copy to .env and fill in values before public hosting

# --- Required (production) ---
DATABASE_URL="file:./prisma/dev.db"
# Prefer Postgres in production, e.g. postgresql://user:pass@host:5432/janark
MONGODB_URI="mongodb://127.0.0.1:27017/janark"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Strong unique secrets (≥24 random chars). NEVER use the defaults in production.
PHONE_HASH_SALT="replace-with-long-random-secret"
HUMAN_TOKEN_SECRET="replace-with-long-random-secret"
IP_HASH_SALT="replace-with-long-random-secret"

# --- OTP SMS (required in production unless ALLOW_OTP_WITHOUT_SMS=1) ---
# Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Or MSG91:
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Local debugging only — NEVER set in production
EXPOSE_DEV_OTP=1
# ALLOW_OTP_WITHOUT_SMS=1

# --- Optional: Cloudflare Turnstile (recommended for public OTP) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: server-side social publish (OFF by default) ---
# ALLOW_CITIZEN_SOCIAL_PUBLISH=1
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_NOTIFY_TO=
