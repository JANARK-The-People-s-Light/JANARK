{
  "auth": {
    "browseRequiresLogin": false,
    "writeRequiresOtp": true
  },
  "portal": {
    "hideRightRailOnCompose": true,
    "hideRailsOnDocumentFocus": true,
    "composePathPattern": "/(share|vote|issues|reports|petitions|feed|notice|memes)/new$",
    "documentFocusPathPattern": "/terms$",
    "followSuggestions": {
      "maxPeople": 3,
      "candidatePool": 32,
      "pollIntervalMs": 120000
    }
  },
  "launch": {
    "publicLaunchIsoDate": "2027-01-26"
  },
  "feed": {
    "hashtagMinTagLength": 3,
    "hashtagMinCount": 1,
    "trendingStrongMinCount": 2,
    "trendingVisibleTopics": 6,
    "trendingMaxTopics": 20,
    "hashtagApiMaxResults": 40,
    "hashtagPollIntervalMs": 30000,
    "activityPostsLabelMinCount": 50,
    "activityActiveLabelMinCount": 10
  },
  "features": {
    "memes": true,
    "notices": true,
    "nativeClients": true,
    "maintainerApplications": true,
    "landingFeedback": true
  },
  "maintainerApply": {
    "rateLimit": 5,
    "windowMs": 3600000
  },
  "landingFeedback": {
    "rateLimit": 8,
    "windowMs": 3600000,
    "messageMaxLength": 2000
  },
  "interactions": {
    "enabled": true,
    "honorDoNotTrack": false,
    "retentionDays": 365,
    "maxEventsPerBatch": 40,
    "maxPropsJsonChars": 4000,
    "maxPathChars": 512,
    "maxQueryChars": 120,
    "searchSampleRate": 1,
    "rateLimitPerMinute": 180,
    "surfaces": ["web", "ios", "android"],
    "names": [
      "page.view",
      "search.query",
      "explore.filter",
      "feed.item_open",
      "engage.vote",
      "engage.comment",
      "content.flag",
      "social.share",
      "follow.toggle",
      "auth.otp_request",
      "auth.verify",
      "auth.logout",
      "prefs.update",
      "upload.complete",
      "ad.impression",
      "ad.click",
      "feedback.submit",
      "maintainer.apply",
      "content.create",
      "content.support",
      "activity.vote",
      "activity.notice",
      "activity.discussion",
      "activity.share",
      "activity.proposal",
      "activity.issue",
      "activity.meme",
      "api.read"
    ]
  }
}
