{
  "name": "janark",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @janark/web",
    "dev:web": "npm run dev -w @janark/web",
    "build": "npm run build -w @janark/web",
    "build:web": "npm run build -w @janark/web",
    "start": "npm run start -w @janark/web",
    "start:web": "npm run start -w @janark/web",
    "lint": "npm run lint -w @janark/web",
    "typecheck": "npm run typecheck -w @janark/web",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "npx tsx --tsconfig apps/web/tsconfig.json prisma/seed.ts",
    "db:demo": "npx tsx --tsconfig apps/web/tsconfig.json prisma/seed-demo.ts",
    "db:clear": "npx tsx --tsconfig apps/web/tsconfig.json prisma/clear-all.ts",
    "db:clear-rate-limits": "npx tsx --tsconfig apps/web/tsconfig.json prisma/clear-rate-limits.ts",
    "db:setup": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:mongo": "docker start janark-mongo || docker run -d --name janark-mongo -p 27017:27017 mongo:7",
    "validate:mobile": "npx tsx scripts/validate-mobile.ts",
    "validate:smoke": "npx tsx scripts/validate-smoke.ts",
    "validate:features": "npx tsx scripts/validate-features.ts",
    "validate:telemetry": "npx tsx --tsconfig apps/web/tsconfig.json scripts/validate-telemetry.ts",
    "validate:native": "npx tsx scripts/validate-native.ts",
    "validate": "npm run typecheck && npm run validate:smoke && npm run validate:features && npm run validate:telemetry && npm run validate:mobile && npm run validate:native",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "npx tsx --tsconfig apps/web/tsconfig.json prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
