{
  "name": "janark",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:demo": "npx tsx prisma/seed-demo.ts",
    "db:clear": "npx tsx prisma/clear-all.ts",
    "db:setup": "prisma migrate dev",
    "db:mongo": "docker start janark-mongo || docker run -d --name janark-mongo -p 27017:27017 mongo:7",
    "validate:mobile": "npx tsx scripts/validate-mobile.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0",
    "mongoose": "^9.8.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "mongodb-memory-server": "^11.2.0",
    "playwright": "^1.49.0",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
