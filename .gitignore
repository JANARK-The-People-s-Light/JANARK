# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/
apps/web/.next/

# production
/build

# misc
.DS_Store
*.pem

# Android (apps/android)
apps/android/.gradle/
apps/android/**/build/
apps/android/local.properties
apps/android/*.iml
apps/android/.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite
/prisma/dev.db
/prisma/dev.db-journal
*.db
*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
apps/web/next-env.d.ts

# generated Prisma client (apps/web)
/apps/web/src/generated/prisma
/src/generated/prisma

# local tooling / agent caches
.agents/
.claude/
.windsurf/
.cursor/
skills-lock.json

# local working assets (app uses public/logo)
/data/
